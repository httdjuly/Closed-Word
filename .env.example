# CloseWord Party — environment settings.
#
# Copy to `.env` and edit. Everything here is optional: the values shown are the
# built-in defaults, so an empty `.env` behaves exactly like no `.env` at all.
#
#   cp .env.example .env
#
# `.env` is gitignored. `.env.example` is not — keep secrets out of it.
#
# A real environment variable always beats the file, so a one-off override is
# just `PORT=9000 deno task start` (PowerShell: `$env:PORT=9000; deno task start`).
#
# Only *operational* settings live here. Game rules — rank bands, hint policy,
# player caps, scoring — are in shared/constants.js, because the browser imports
# that file too and the two sides must never disagree.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# 8791 rather than the more obvious 8787, which a stray tool tends to squat on.
PORT=8791

# 0.0.0.0 binds every interface, which is what lets teammates reach you at
# http://<your-lan-ip>:8791. Set 127.0.0.1 to keep the server to this machine.
#
# Note that a plain-http LAN address is not a "secure context", so browsers hide
# crypto.randomUUID and navigator.clipboard there. The client already works
# without both — mentioned only so the behaviour isn't a surprise.
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Word data
# ---------------------------------------------------------------------------

# Embedding pack built by `deno task ingest`. The default 50,000-word pack is
# what makes ranks match closeword.org; a smaller pack starts losing ordinary
# words (check with `deno run --allow-read scripts/coverage.ts`).
CLOSEWORD_PACK=data/vectors.bin

# Curated secret-word pool for the CloseWord source. Missing file is fine — the
# server falls back to the most frequent words in the pack.
CLOSEWORD_SECRET_POOL=data/secret-words.txt

# How many per-round rank tables to keep in memory. One is ~200 KB at 50k words
# and a room reuses its table for a whole round, so read this as "how many
# concurrent rounds stay fast".
CLOSEWORD_RANK_CACHE=48

# ---------------------------------------------------------------------------
# claude -p integration (all of it optional)
# ---------------------------------------------------------------------------

# auto = use the CLI if it is installed, otherwise carry on without it.
# off   = never spawn `claude`, disabling both in-round prose clues and the
#         per-player assistant behind the chat button.
CLOSEWORD_AI_CLUES=auto

# Binary to invoke. An absolute path is useful when `claude` isn't on PATH for
# whatever user the server runs as.
CLOSEWORD_CLAUDE_BIN=claude

# Passed to `claude --model`. Leave unset for the CLI's own default.
# CLOSEWORD_CLAUDE_MODEL=claude-sonnet-5

# Assistant chat timeout. Generous on purpose: a considered answer measured
# 23 s here, and a reply blocks nothing except its own chat bubble. Too tight and
# answers get killed mid-sentence, which looks exactly like a crash.
CLOSEWORD_ASSIST_TIMEOUT_MS=90000

# In-round clue timeout. Impatient on purpose — a clue that arrives after the
# board has moved on is worse than no clue.
CLOSEWORD_CLUE_TIMEOUT_MS=30000

# Offline word curation (`deno task curate`). Nothing is waiting on it, and
# vetting a batch of 100 words takes far longer than answering one question — at
# 90 s, two batches of a 32-batch run timed out and their words went unreviewed.
CLOSEWORD_CURATE_TIMEOUT_MS=180000

# The chat button. false leaves in-round clues working and the Look tab fully
# usable — appearance is all client-side — it only stops the conversation.
CLOSEWORD_ASSISTANT=true

# Assistant calls per player per minute. Each one forks a `claude` process, so
# this is really a CPU guard. Use CLOSEWORD_ASSISTANT=false to turn chat off;
# a cap of 0 is rejected because it would look like a bug to whoever asked.
CLOSEWORD_ASSIST_PER_MINUTE=10

# Longest question accepted, in characters.
CLOSEWORD_ASSIST_MAX_CHARS=500

# ---------------------------------------------------------------------------
# WebSocket limits
# ---------------------------------------------------------------------------

# Largest single client frame. Raise only if you raise the assistant character
# limit well past its default.
CLOSEWORD_MAX_MESSAGE_BYTES=4096

# The ceiling for the one frame that carries a document rather than a sentence:
# a board file for Cờ tỷ phú. The four boards that ship are 9–11KB each, and the
# lobby's "tải mẫu bản đồ" hands one of them back as a starting point, so this
# has to comfortably clear them. Only a monoMap message gets this ceiling.
CLOSEWORD_MAX_MAP_BYTES=65536

# Flood guard: at most this many messages per window, per socket. Separate from
# the in-game guess rate limit, which is a rule and lives in shared/constants.js.
CLOSEWORD_SOCKET_MSG_LIMIT=60
CLOSEWORD_SOCKET_MSG_WINDOW_MS=5000

# State-broadcast coalescing window. A burst of near-simultaneous guesses turns
# into one snapshot per room instead of one per guess. 0 sends immediately.
CLOSEWORD_BROADCAST_DEBOUNCE_MS=20

# ---------------------------------------------------------------------------
# Room housekeeping
# ---------------------------------------------------------------------------

# An empty room is reaped after this many idle minutes, so a day of play doesn't
# leave a hundred dead rooms holding rank tables.
CLOSEWORD_ROOM_IDLE_MINUTES=20

# How often the sweeper runs.
CLOSEWORD_ROOM_SWEEP_SECONDS=60

# Hard ceiling on live rooms. Hitting it triggers an aggressive sweep first.
CLOSEWORD_MAX_ROOMS=500

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
#
# One file per day: logs/closeword-YYYY-MM-DD.log, with four channels —
# service (start, config, shutdown), action (what people did), http (requests
# and sockets) and webhook (outbound `claude -p` calls). Errors keep the channel
# of whatever failed, so a timeout files with the other webhook lines.

CLOSEWORD_LOG_DIR=logs

# debug | info | warn | error.
#
# `debug` additionally records individual guesses, hint words and clue results.
# Off by default deliberately: the host usually plays too, and the host is the
# person who can read the log file — at info, nothing in it helps them win.
CLOSEWORD_LOG_LEVEL=info

# The active file is rolled aside to `...-1.log`, `...-2.log` once a write would
# take it past this, so the live file never exceeds it. Rolled rather than
# truncated in place: a file hits its cap precisely when something has gone
# wrong, and truncation throws away the lines leading up to it.
CLOSEWORD_LOG_MAX_BYTES=2000000

# Delete day-files (and their rolled parts) older than this. Checked at startup
# and once a day after that. This is the only thing bounding the directory, so 0
# — keep everything — means exactly that.
CLOSEWORD_LOG_KEEP_DAYS=5

# Mirror log lines to the terminal as well as the file.
CLOSEWORD_LOG_CONSOLE=true

# false makes it console-only and writes nothing to disk.
CLOSEWORD_LOG_TO_FILE=true

# ---------------------------------------------------------------------------
# Claude integration
# ---------------------------------------------------------------------------

# Set to `off` to skip loading server/ai.ts entirely — no clues, no assistant,
# no word lookup, and no subprocess. `deno task prod` sets this for you, and a
# tree from `deno task build:prod` has no ai.ts to load in the first place.
# CLOSEWORD_AI=off

# ---------------------------------------------------------------------------
# Confluence (only for `deno task ingest:custom`)
# ---------------------------------------------------------------------------

# Used once, offline, to build the custom word list. The ingest reads pages from
# the space you name and writes out word *frequencies* only — no page text is ever
# stored anywhere. Never commit real values; keep them in `.env`, gitignored.
# CONFLUENCE_SITE=your-team.atlassian.net
# CONFLUENCE_EMAIL=you@example.com
# CONFLUENCE_API_TOKEN=

# ---------------------------------------------------------------------------
# Load simulation (only for `deno task sim`)
# ---------------------------------------------------------------------------

# Server the simulated players connect to. Defaults to the local server on PORT.
# CLOSEWORD_URL=http://127.0.0.1:8791
